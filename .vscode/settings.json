{
    "tailwind-fold.autoFold": false,
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "editor.quickSuggestions": {
        "strings": "on"
    },
    "tailwindCSS.classAttributes": [
        "class",
        "ui",
        "enter-active-class",
        "leave-active-class",
        "leave-to-class",
        "enter-from-class",
        "enter-to-class",
        "leave-from-class"
    ],
    "tailwindCSS.experimental.classRegex": [
        [
            "ui:\\s*{([^)]*)\\s*}",
            "(?:'|\"|`)([^']*)(?:'|\"|`)"
        ],
        [
            "document.body.classList.add\\((?:'|\"|`)([^']*)(?:'|\"|`)",
            "(?:'|\"|`)([^']*)(?:'|\"|`)"
        ],
        [
            "document.body.classList.remove\\((?:'|\"|`)([^']*)(?:'|\"|`)",
            "(?:'|\"|`)([^']*)(?:'|\"|`)"
        ]
    ]
}
